{
  "expo": {
    "name": "Saloon_Vero_App",
    "slug": "Saloon_Vero_App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saloonveroapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.saloonvero.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.saloonvero.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Saloon Vero uses your photos to set your profile picture and share images in chat.",
          "cameraPermission": "Saloon Vero uses your camera to take a profile picture or capture photos to share in chat.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A87A2E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d861ed91-cb4c-4946-b311-cedeec3a9ab5"
      }
    }
  }
}
